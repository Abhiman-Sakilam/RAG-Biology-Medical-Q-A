# Groq API key (https://console.groq.com). Required.
GROQ_API_KEY=

# Optional: model override (default in config.toml).
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: use OpenAI instead – set OPENAI_API_KEY and OPENAI_BASE_URL (leave unset for OpenAI default).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
