# Groq API key (https://console.groq.com). Required.
GROQ_API_KEY=your_groq_api_key_here

# Optional: model override (default in config.toml).
# GROQ_MODEL=llama-3.3-70b-versatile

# Required when [retrieval] mode = hybrid in config.toml (dense embeddings via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative: OpenAI embeddings (if not using OpenRouter)
# OPENAI_API_KEY=your_openai_api_key_here
